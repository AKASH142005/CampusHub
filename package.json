{
  "name": "campushub-monorepo",
  "version": "1.0.0",
  "description": "CampusHub - Complete College & Campus Management Web Application",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,cyan\"",
    "build:backend": "echo 'No backend build needed for Fastify'",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:frontend"
  },
  "keywords": [
    "campushub",
    "react",
    "fastify",
    "vite",
    "material-ui",
    "mysql"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
